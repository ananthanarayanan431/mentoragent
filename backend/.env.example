# ---------------------------------------------------------------------------
# MentorAgents - backend environment
#
# Copy to .env and fill in the secrets:  make env
# Everything not listed here falls back to the default in
# src/mentoragent/core/config/
# ---------------------------------------------------------------------------

# --- Application ---
PROJECT_NAME=MentorAgents
# local | dev | test | staging | prod
ENVIRONMENT=local
LOCAL_DEVELOPMENT=true
DEBUG=true
APP_VERSION=0.1.0
# TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL (DEBUG=true forces DEBUG)
LOG_LEVEL=INFO
# true = one JSON object per line, for log shippers in deployed environments
LOG_JSON=false

# --- Server ---
HOST=0.0.0.0
PORT=8000
RELOAD=true

# --- MongoDB (consumed by docker-compose.yml) ---
MONGO_USER=mentor_user
MONGO_PASSWORD=mentor_password
MONGO_PORT=27017

# Consumed by the app. Keep the credentials/port in sync with the three
# variables above - docker-compose.yml builds the container from those.
MONGO_URI=mongodb://mentor_user:mentor_password@localhost:27017/?directConnection=true
MONGO_DB_NAME=mentoragents
MONGO_MENTORS_COLLECTION=mentors
MONGO_STATE_CHECKPOINT_COLLECTION=mentor_state_checkpoints
MONGO_STATE_WRITES_COLLECTION=mentor_state_writes
MONGO_LONG_TERM_MEMORY_COLLECTION=mentor_long_term_memory

# --- Groq (required) ---
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_LLM_MODEL_CONTEXT_SUMMARY=llama-3.1-8b-instant

# --- OpenRouter (required) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.7
# Optional attribution headers shown on openrouter.ai rankings
# OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=mentoragent

# --- Arcade (required) ---
ARCADE_API_KEY=
ARCADE_USER_ID=

# --- LangSmith (API key required) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=mentoragents

# --- Comet ML / Opik (optional) ---
# Left unset on purpose: an empty value would load as "" rather than None.
# COMET_API_KEY=
COMET_PROJECT=mentor_agents

# --- Agent memory ---
TOTAL_MESSAGES_SUMMARY_TRIGGER=30
TOTAL_MESSAGES_AFTER_SUMMARY=5

# --- RAG ---
# Served through OpenRouter, using OPENROUTER_API_KEY.
RAG_TEXT_EMBEDDING_MODEL_ID=openai/text-embedding-3-small
# Must match numDimensions on the Atlas vector search index.
RAG_TEXT_EMBEDDING_MODEL_DIM=1536
RAG_TOP_K=3
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=10

# --- CORS (comma or semicolon separated) ---
ADDITIONAL_CORS_ORIGINS=http://localhost:3000

# --- Paths ---
EXTRACTION_METADATA_FILE_PATH=data/extraction_metadata.json
EVALUATION_DATASET_FILE_PATH=data/evaluation_dataset.json
