# Normalise line endings to LF in the repo, whatever the OS that checked it out.
* text=auto eol=lf
*.sh text eol=lf
.githooks/* text eol=lf

# Lockfiles are generated: collapse them in GitHub diffs and language stats.
backend/uv.lock linguist-generated=true -diff
frontend/package-lock.json linguist-generated=true -diff
