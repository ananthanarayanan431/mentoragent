# Python rules for this agent. Env files, editors, OS files and node_modules are
# ignored by the root .gitignore.

# Virtualenv, caches and build output
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage
.coverage
coverage.xml
htmlcov/

# Generated by `mentor-agent generate-dataset`
data/evaluation_dataset.json
