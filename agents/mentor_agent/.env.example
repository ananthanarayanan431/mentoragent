# ---------------------------------------------------------------------------
# MentorAgents - mentor agent environment
#
# Copy to .env and fill in the secrets:  make env
# MongoDB's own credentials (for the container) live in infra/.env.
# Everything not listed here falls back to the default in
# mentor_agent/config/
# ---------------------------------------------------------------------------

# --- Application ---
PROJECT_NAME=MentorAgents
# local | dev | test | staging | prod
ENVIRONMENT=local
LOCAL_DEVELOPMENT=true
DEBUG=true
APP_VERSION=0.1.0
# TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL (DEBUG=true forces DEBUG)
LOG_LEVEL=INFO
# true = one JSON object per line, for log shippers in deployed environments
LOG_JSON=false
# When set, every /api/v1 call must send it as the X-API-Key header
# (WebSocket: ?api_key=...). Strongly recommended outside local development.
API_KEY=

# --- Server ---
HOST=0.0.0.0
PORT=8000
RELOAD=true
# Threads for blocking library calls made from async code (checkpointer, retriever).
WORKER_THREADS=40

# --- MongoDB ---
# Keep the credentials and port in sync with infra/.env (MONGO_USER,
# MONGO_PASSWORD, MONGO_PORT), which the container is created from.
MONGO_URI=mongodb://mentor_user:mentor_password@localhost:27017/?directConnection=true
MONGO_DB_NAME=mentoragents
MONGO_MENTORS_COLLECTION=mentors
MONGO_STATE_CHECKPOINT_COLLECTION=mentor_state_checkpoints
MONGO_STATE_WRITES_COLLECTION=mentor_state_writes
MONGO_LONG_TERM_MEMORY_COLLECTION=mentor_long_term_memory
# Expire idle conversations after this many seconds (blank = keep forever)
MONGO_CONVERSATION_TTL_SECONDS=

# --- Anthropic (required: every chat call) ---
ANTHROPIC_API_KEY=
# Only claude-haiku-* and claude-sonnet-* models are accepted.
# Haiku is the cheap default; switch the mentor to claude-sonnet-5-5 for better answers.
ANTHROPIC_LLM_MODEL=claude-haiku-5-5
# Model for conversation / context summaries
ANTHROPIC_LLM_MODEL_CONTEXT_SUMMARY=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_RETRIES=2
# Web research when you create your own mentor (web searches are billed per search)
ANTHROPIC_RESEARCH_MODEL=claude-sonnet-5-5
ANTHROPIC_RESEARCH_MAX_SEARCHES=6
ANTHROPIC_RESEARCH_TIMEOUT_SECONDS=300

# --- OpenRouter (required: embeddings only; Anthropic has no embeddings API) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
# Optional attribution headers shown on openrouter.ai rankings
# OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=mentoragent

# --- Arcade (optional: fetches tweets during ingestion) ---
ARCADE_API_KEY=
ARCADE_USER_ID=

# --- LangSmith (optional tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=mentoragents

# --- Comet ML / Opik (optional tracing; required for `mentor-agent evaluate`) ---
COMET_API_KEY=
COMET_PROJECT=mentor_agents

# --- Agent ---
TOTAL_MESSAGES_SUMMARY_TRIGGER=30
TOTAL_MESSAGES_AFTER_SUMMARY=5
MAX_MESSAGE_CHARS=4000
# Max graph steps per turn (guards against runaway tool loops)
RECURSION_LIMIT=12

# --- RAG ---
# Served through OpenRouter, using OPENROUTER_API_KEY.
RAG_TEXT_EMBEDDING_MODEL_ID=openai/text-embedding-3-small
# Must match numDimensions on the Atlas vector search index.
RAG_TEXT_EMBEDDING_MODEL_DIM=1536
RAG_TOP_K=3
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=10
RAG_VECTOR_INDEX_NAME=vector_index
RAG_FULLTEXT_INDEX_NAME=hybrid_search_index

# --- CORS (comma or semicolon separated) ---
ADDITIONAL_CORS_ORIGINS=http://localhost:3000

# --- Paths ---
# Relative paths resolve against the agent folder (MENTOR_AGENT_DIR; /app in the image).
EXTRACTION_METADATA_FILE_PATH=data/extraction_metadata.json
EVALUATION_DATASET_FILE_PATH=data/evaluation_dataset.json
