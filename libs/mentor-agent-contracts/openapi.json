{
  "components": {
    "schemas": {
      "ChatRequest": {
        "additionalProperties": false,
        "description": "A user message to a mentor.\n\nOmit ``conversation_id`` to start a new conversation; send back the id\nfrom the response to continue it.",
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "mentor_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Mentor Id",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "mentor_id",
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "description": "The mentor's reply.",
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "mentor_id": {
            "title": "Mentor Id",
            "type": "string"
          },
          "response": {
            "title": "Response",
            "type": "string"
          }
        },
        "required": [
          "mentor_id",
          "conversation_id",
          "response"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MentorOut": {
        "description": "Public view of a mentor (sources are at ``/mentors/{id}/sources``).",
        "properties": {
          "expertise": {
            "title": "Expertise",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "memory": {
            "anyOf": [
              {
                "enum": [
                  "building",
                  "ready",
                  "failed"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Memory build status for mentors added or rebuilt through the API.",
            "title": "Memory"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "perspective": {
            "title": "Perspective",
            "type": "string"
          },
          "style": {
            "title": "Style",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "expertise",
          "perspective",
          "style"
        ],
        "title": "MentorOut",
        "type": "object"
      },
      "MentorSources": {
        "description": "Where a mentor's long-term memory comes from (Wikipedia is searched by name).",
        "properties": {
          "pdfs": {
            "items": {
              "type": "string"
            },
            "title": "Pdfs",
            "type": "array"
          },
          "twitter_handle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Twitter Handle"
          },
          "websites": {
            "items": {
              "type": "string"
            },
            "title": "Websites",
            "type": "array"
          },
          "youtube_videos": {
            "items": {
              "type": "string"
            },
            "title": "Youtube Videos",
            "type": "array"
          }
        },
        "title": "MentorSources",
        "type": "object"
      },
      "MentorUpdate": {
        "additionalProperties": false,
        "description": "Changes to a mentor; omitted fields stay as they are. Changing sources does\nnot rebuild the memory by itself: call ``POST /mentors/{id}/memory`` after.",
        "properties": {
          "expertise": {
            "anyOf": [
              {
                "maxLength": 600,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expertise"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 600,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "pdfs": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 2000,
                  "pattern": "^https://\\S+$",
                  "type": "string"
                },
                "maxItems": 20,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pdfs"
          },
          "perspective": {
            "anyOf": [
              {
                "maxLength": 600,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Perspective"
          },
          "style": {
            "anyOf": [
              {
                "maxLength": 600,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Style"
          },
          "twitter_handle": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_]{1,15}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Twitter Handle"
          },
          "websites": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 2000,
                  "pattern": "^https://\\S+$",
                  "type": "string"
                },
                "maxItems": 20,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Websites"
          },
          "youtube_videos": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 2000,
                  "pattern": "^https://\\S+$",
                  "type": "string"
                },
                "maxItems": 20,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Youtube Videos"
          }
        },
        "title": "MentorUpdate",
        "type": "object"
      },
      "PoolOut": {
        "description": "How many pool mentors can still be added.",
        "properties": {
          "remaining": {
            "title": "Remaining",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "remaining",
          "total"
        ],
        "title": "PoolOut",
        "type": "object"
      },
      "ResetMemoryResponse": {
        "description": "Collections dropped by a memory reset.",
        "properties": {
          "dropped_collections": {
            "items": {
              "type": "string"
            },
            "title": "Dropped Collections",
            "type": "array"
          }
        },
        "title": "ResetMemoryResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "MentorAgents mentor agent",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/chat": {
      "post": {
        "description": "Send a message to a mentor and get the full reply.",
        "operationId": "chat_api_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Chat",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/v1/conversations/{mentor_id}/{conversation_id}": {
      "delete": {
        "description": "Forget a conversation's history.",
        "operationId": "delete_conversation_api_v1_conversations__mentor_id___conversation_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "mentor_id",
            "required": true,
            "schema": {
              "title": "Mentor Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Delete Conversation",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/v1/mentors": {
      "get": {
        "description": "List every available mentor.",
        "operationId": "list_mentors_api_v1_mentors_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MentorOut"
                  },
                  "title": "Response List Mentors Api V1 Mentors Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "List Mentors",
        "tags": [
          "mentors"
        ]
      }
    },
    "/api/v1/mentors/pool": {
      "get": {
        "description": "How many mentors \"Add a mentor\" can still bring into the square.",
        "operationId": "mentor_pool_api_v1_mentors_pool_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Mentor Pool",
        "tags": [
          "mentors"
        ]
      }
    },
    "/api/v1/mentors/random": {
      "post": {
        "description": "Add a random mentor from the pool, and build their memory in the background.\n\nThe mentor can be talked to at once; answers draw on their memory once its\nstatus turns ``ready``. 409 when every pool mentor is already here.",
        "operationId": "add_random_mentor_api_v1_mentors_random_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MentorOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Add Random Mentor",
        "tags": [
          "mentors"
        ]
      }
    },
    "/api/v1/mentors/{mentor_id}": {
      "delete": {
        "description": "Remove a mentor and their long-term memory. Pool mentors can be added again.\n\n409 while their memory is being built.",
        "operationId": "remove_mentor_api_v1_mentors__mentor_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "mentor_id",
            "required": true,
            "schema": {
              "title": "Mentor Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Remove Mentor",
        "tags": [
          "mentors"
        ]
      },
      "get": {
        "description": "Return one mentor.",
        "operationId": "get_mentor_api_v1_mentors__mentor_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "mentor_id",
            "required": true,
            "schema": {
              "title": "Mentor Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MentorOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Get Mentor",
        "tags": [
          "mentors"
        ]
      },
      "patch": {
        "description": "Change a mentor's persona or sources. Rebuild the memory to use new sources.",
        "operationId": "update_mentor_api_v1_mentors__mentor_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "mentor_id",
            "required": true,
            "schema": {
              "title": "Mentor Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MentorUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MentorOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Update Mentor",
        "tags": [
          "mentors"
        ]
      }
    },
    "/api/v1/mentors/{mentor_id}/memory": {
      "post": {
        "description": "Rebuild the mentor's long-term memory in the background (409 if already running).",
        "operationId": "rebuild_mentor_memory_api_v1_mentors__mentor_id__memory_post",
        "parameters": [
          {
            "in": "path",
            "name": "mentor_id",
            "required": true,
            "schema": {
              "title": "Mentor Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MentorOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Rebuild Mentor Memory",
        "tags": [
          "mentors"
        ]
      }
    },
    "/api/v1/mentors/{mentor_id}/sources": {
      "get": {
        "description": "Where the mentor's long-term memory is built from.",
        "operationId": "get_mentor_sources_api_v1_mentors__mentor_id__sources_get",
        "parameters": [
          {
            "in": "path",
            "name": "mentor_id",
            "required": true,
            "schema": {
              "title": "Mentor Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MentorSources"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Get Mentor Sources",
        "tags": [
          "mentors"
        ]
      }
    },
    "/api/v1/reset-memory": {
      "post": {
        "description": "Delete every conversation's short-term memory.\n\nIn production this is only enabled when an ``API_KEY`` protects the API.",
        "operationId": "reset_memory_api_v1_reset_memory_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetMemoryResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Reset Memory",
        "tags": [
          "admin"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness: the process is up and serving requests.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: dependencies (MongoDB) are reachable.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
