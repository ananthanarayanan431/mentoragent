# Rendered to /etc/nginx/conf.d/default.conf at container start by the image's
# envsubst step. NGINX_ENVSUBST_FILTER (set in the Dockerfile) limits
# substitution to BACKEND_*, so nginx's own $host / $uri survive untouched.

upstream backend {
    server ${BACKEND_HOST};
}

# "Connection: upgrade" only when the client asked to upgrade; a plain request
# proxied with that header set would break keep-alive.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # nginx-unprivileged cannot bind ports below 1024.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The image runs as a non-root user, so keep temp paths writable.
    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/manifest+json;

    include /etc/nginx/snippets/security-headers.conf;

    # --- API ---------------------------------------------------------------
    # Same-origin proxying, so the browser never needs CORS and the frontend
    # ships with an empty VITE_API_URL.
    location /api/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrade for /api/v1/ws/chat.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Streamed replies arrive token by token; buffering would batch them
        # into one lump, and a short read timeout would cut off a long answer.
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /health {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        access_log off;
    }

    location = /ready {
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    # --- Static assets -----------------------------------------------------
    # Vite fingerprints these filenames, so they can be cached indefinitely.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    # index.html must never be cached, or a deploy leaves clients on old
    # markup pointing at asset filenames that no longer exist.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # Client-side routing: unknown paths render the SPA rather than 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
