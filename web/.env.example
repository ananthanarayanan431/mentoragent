# ---------------------------------------------------------------------------
# MentorAgents - frontend environment
#
# Copy to .env.local and edit. Only variables prefixed with VITE_ reach the
# browser, and they are BAKED INTO THE BUNDLE at build time: anyone who loads
# the site can read them. Never put a real secret here.
# ---------------------------------------------------------------------------

# Where the API lives. Leave empty to call the same origin the app is served
# from, which is what you want behind the nginx image (it proxies to the
# backend) and in `npm run dev` (Vite proxies to localhost:8000).
# Set it only when the API is on a different host, e.g. https://api.example.com
VITE_API_URL=

# Only needed when the backend runs with API_KEY set. This is a light gate for
# a private deployment, not real auth - see the warning above.
VITE_API_KEY=

# Backend address used by the dev-server proxy (build-time only, not shipped).
# VITE_DEV_BACKEND=http://localhost:8000
