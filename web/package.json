{
  "name": "@mentoragent/web",
  "version": "0.1.0",
  "private": true,
  "description": "Web app: pick a mentor, then chat with replies streamed over a WebSocket.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
