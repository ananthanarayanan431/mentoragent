    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mentoragent/mentor-agent-contracts": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "lucide-react": "^1.72.0",
    "phaser": "4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.93.0",
    "typescript": "~7.0.2",
