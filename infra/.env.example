# Infra settings, read by the compose files in this folder.
# Copy to infra/.env and adjust. Never commit real values.

# MongoDB root user, created on the first start of an empty volume.
MONGO_USER=mentor_user
MONGO_PASSWORD=mentor_password
MONGO_PORT=27017

# Host ports for the containerised agent and web app (make stack-up).
MENTOR_AGENT_PORT=8000
WEB_PORT=8080
