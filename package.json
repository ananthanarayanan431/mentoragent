{
  "name": "mentoragent",
  "private": true,
  "description": "MentorAgents: chat with AI mentors grounded in their published material.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mentoragent/web dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "pnpm --filter @mentoragent/e2e-tests e2e"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
